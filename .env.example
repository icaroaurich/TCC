# Copie este arquivo para .env e preencha (o servidor só lê o .env).

# Painel da Meta > seu app > Configurações do app > Básico: "ID do Aplicativo" e "Chave Secreta do Aplicativo".
META_APP_ID=
META_APP_SECRET=

# ID da configuração criada em Casos de uso > API do Instagram > "API setup with Unified login".
META_CONFIG_ID=

# Versão da Graph API (veja a atual em developers.facebook.com/docs/graph-api/changelog)
GRAPH_VERSION=v27.0

# Endereço https público deste servidor. A Meta usa para voltar do login e o Instagram para baixar as imagens.
# Rode: cloudflared tunnel --url http://localhost:3000  e cole a URL https://....trycloudflare.com
# Na configuração do Unified login, use como Redirect URL: <PUBLIC_URL>/auth/instagram/callback
PUBLIC_URL=

PORT=3000
